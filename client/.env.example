# انسخ الملف إلى client/.env للتطوير، أو أضف القيم لخدمة الواجهة على Render.
# جميع متغيرات VITE_* عامة وتظهر في ملفات المتصفح؛ لا تضع فيها أسرارًا.
# تغيير هذه القيم يتطلب إعادة بناء الواجهة.

# عنوان API المنشور المرتبط بالتطبيق والموقع (يشمل /api).
VITE_API_URL=https://study-birds1.onrender.com/api
# للتطوير باستخدام سيرفر محلي: VITE_API_URL=http://localhost:5000/api

# عنوان الواجهة العام المستخدم في SEO وخريطة الموقع؛ غيّره إلى نطاقك الفعلي.
VITE_SITE_URL=https://study-birds.onrender.com
# NEXT_PUBLIC_SITE_URL اسم قديم مدعوم وله أولوية؛ استخدم VITE_SITE_URL وحده عادةً.

# اختياري: اتركه فارغًا لإخفاء تسجيل الدخول عبر Google.
# عند التفعيل استخدم Web Client ID نفسه في GOOGLE_CLIENT_ID على السيرفر،
# وأضف نطاق الواجهة إلى Authorized JavaScript origins في Google Cloud.
VITE_GOOGLE_CLIENT_ID=

# بيانات التواصل العامة؛ استبدل الأمثلة ببيانات المؤسسة.
VITE_CONTACT_EMAIL=hello@example.com
VITE_WHATSAPP_URL=https://wa.me/201000000000
VITE_FACEBOOK_URL=https://facebook.com/studybirds
VITE_INSTAGRAM_URL=https://instagram.com/studybirds
VITE_TIKTOK_URL=https://tiktok.com/@studybirds

# الاستعادة وتأكيد البريد و2FA تعتمد على SMTP في server/.env فقط.
# لا تضع SMTP_PASS أو JWT_SECRET أو مفاتيح النشر في ملف الواجهة.
